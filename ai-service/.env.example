# OpenWeatherMap (бесплатен на https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=your-openweathermap-key-here

# Опционални LLM провајдери. Сервисот пробува по овој редослед и
# паѓа на template-based објаснување ако ниту еден клуч не е поставен:
#   1. Groq (бесплатен; https://console.groq.com)
#   2. Anthropic (платен после $5 free кредит; https://console.anthropic.com)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
